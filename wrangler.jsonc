{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "advisor-practice",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "TrainingSession" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TrainingSession"] }],
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "731402",
      "simple": { "limit": 25, "period": 60 },
    },
  ],
  "vars": { "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct" },
}
